#!/bin/sh
set -eu

case "$(uname -s)" in
  Darwin) installer_url='https://harnessharlot.com/install-macos' ;;
  Linux) installer_url='https://harnessharlot.com/install-linux' ;;
  *) echo "unsupported operating system: $(uname -s)" >&2; exit 1 ;;
esac

for command in curl mktemp; do
  command -v "$command" >/dev/null 2>&1 || { echo "$command is required" >&2; exit 1; }
done
work=$(mktemp -d "${TMPDIR:-/tmp}/hh-bootstrap.XXXXXX")
cleanup() { rm -rf "$work"; }
trap cleanup EXIT HUP INT TERM
platform_installer="$work/install"
curl -fsS "$installer_url" -o "$platform_installer"
sh "$platform_installer" "$@"
