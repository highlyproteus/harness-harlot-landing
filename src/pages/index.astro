---
import "../styles/global.css";

const repoUrl = "https://github.com/highlyproteus/harness-harlot";
const releaseUrl = `${repoUrl}/releases/latest`;
const xUrl = "https://x.com/harnessharlot";
const installCommand = "curl -fsS https://harnessharlot.com/install | sh";
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#efece4" media="(prefers-color-scheme: light)" />
    <meta name="description" content="Harness Harlot is a native terminal workstation for local and SSH work, with tabs, splits, groups, tmux, and embedded browser tabs." />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href="https://harnessharlot.com/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500..800&family=JetBrains+Mono:wght@400;500&display=swap" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Harness Harlot" />
    <meta property="og:title" content="Harness Harlot — Command everything." />
    <meta property="og:description" content="A native terminal workstation for your local machine, SSH hosts, tmux sessions, and browser tabs." />
    <meta property="og:url" content="https://harnessharlot.com/" />
    <meta property="og:image" content="https://harnessharlot.com/og.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@harnessharlot" />
    <meta name="twitter:creator" content="@harnessharlot" />
    <meta name="twitter:title" content="Harness Harlot — Command everything." />
    <meta name="twitter:description" content="A native terminal workstation for local and SSH work." />
    <meta name="twitter:image" content="https://harnessharlot.com/og.jpg" />
    <title>Harness Harlot — Native terminal workstation</title>
    <script is:inline>
      (() => {
        const stored = localStorage.getItem("hh-theme");
        const theme = stored === "light" || stored === "dark"
          ? stored
          : matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="frame" aria-hidden="true"></div>

    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href="#top" aria-label="Harness Harlot home">
          <img class="brand-mark" src="/images/harness-harlot-mark.webp" alt="" width="32" height="32" />
          <span class="brand-text">Harness Harlot</span>
        </a>
        <nav class="site-nav" aria-label="Primary navigation">
          <a href="#workstations">Workstations</a>
          <a href="#features">Features</a>
          <a href={xUrl} rel="me">X <span aria-hidden="true">↗</span></a>
          <a class="nav-primary" href={repoUrl}>GitHub <span aria-hidden="true">↗</span></a>
        </nav>
        <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch to light theme">
          <span class="glyph" data-theme-glyph aria-hidden="true">☾</span>
          <span class="label" data-theme-label>Nox</span>
        </button>
      </div>
    </header>

    <main id="main">
      <section class="hero" id="top">
        <div class="wrap">
          <figure class="plate hero-banner">
            <img
              src="/images/harness-harlot-banner.webp"
              alt="A Victorian woman riding an armored crab through a gothic industrial city beside the Harness Harlot wordmark"
              width="1800"
              height="600"
              fetchpriority="high"
            />
            <figcaption class="hero-caption">
              <span>Born in the terminal</span>
              <span>Dressed for the apocalypse</span>
            </figcaption>
          </figure>
        </div>

        <div class="wrap hero-body">
          <h1 class="sr-only">Harness Harlot — native terminal workstation for macOS and Linux</h1>
          <p class="kicker"><b>†</b> Native terminal workstation · macOS + Linux</p>
          <p class="summary">
            Harness Harlot is a <span class="accent">terminal multiplexer built in Rust</span> —
            GPU-rendered panes for local shells and SSH hosts. Tabs, splits, groups, tmux integration,
            and embedded browser tabs in one native window. Your terminals keep running when the app
            closes, crashes, or updates.
          </p>

          <ul class="spec-strip">
            <li>Rust</li>
            <li>GPU rendering | gpui</li>
            <li>MIT</li>
          </ul>

          <div class="cta-row">
            <a class="button button-primary" href={releaseUrl}>
              <span aria-hidden="true">⌘</span> Download for macOS
            </a>
            <a class="button button-secondary" href={releaseUrl}>
              <span aria-hidden="true">λ</span> Download for Linux
            </a>
          </div>

          <div class="install-panel install-inline">
            <div class="command-box">
              <div class="command-head">
                <span>macOS + Linux</span>
                <button class="copy-button" type="button" data-copy aria-label="Copy install command">Copy</button>
              </div>
              <code data-command>{installCommand}</code>
            </div>
            <p class="copy-status" data-copy-status aria-live="polite"></p>
          </div>
        </div>

        <div class="wrap">
          <figure class="plate hero-shot">
            <img
              src="/images/harness-harlot-app.png"
              alt="Harness Harlot showing a local workstation with an AI agent pane and a release-status terminal pane"
              width="1280"
              height="820"
            />
          </figure>
        </div>
      </section>

      <section class="section" id="workstations">
        <div class="wrap">
          <div class="section-head">
            <p class="kicker"><b>01</b> Your machines, made tangible</p>
            <h2>What is a<br /><span class="accent">workstation?</span></h2>
            <div class="intro-copy">
              <p class="large">A workstation is simply a place where you work: your Mac, your Linux box, or any machine you reach over SSH.</p>
              <p>
                Each one remembers its name, color, working folder, and terminal layout. Pin the machines
                you live in. Open a new shell and land where you meant to be. Your SSH setup stays
                yours — Harness Harlot uses the keys, agents, hosts, and verification rules you already trust.
              </p>
            </div>
          </div>

          <div class="machines" aria-label="Example workstations">
            <div><span>Workstation 01</span><i class="dot dot-red"></i> Local / forge</div>
            <div><span>Workstation 02</span><i class="dot dot-sand"></i> SSH / production</div>
            <div><span>Workstation 03</span><i class="dot dot-blue"></i> SSH / studio</div>
          </div>
        </div>
      </section>

      <section class="section" id="features">
        <div class="wrap">
          <div class="section-head">
            <p class="kicker"><b>02</b> The working set</p>
            <h2>Built for how<br />terminal work <span class="accent">actually happens.</span></h2>
            <p>Move from a single command to a whole machine room without losing the thread.</p>
          </div>

          <div class="feature-grid">
            <article class="feature feature-span-2">
              <p class="feature-index">A</p>
              <h3>Terminals that survive</h3>
              <p>Your shells keep running when the window closes, the app updates, or the desktop gets out of your way. Reopen it and pick up where you left off.</p>
              <div class="mini-term" aria-hidden="true">
                <span>$ hh version</span>
                <b>Harness Harlot v0.1.10</b>
                <span class="cursor">▮</span>
              </div>
            </article>

            <article class="feature">
              <p class="feature-index">B</p>
              <h3>Tabs, panes, groups</h3>
              <p>Split in any direction, drag the layout into shape, and bring several terminals — or a browser — together for one task.</p>
            </article>

            <article class="feature">
              <p class="feature-index">C</p>
              <h3>tmux, on your terms</h3>
              <p>Ask for a scan, choose a session, and attach. Nothing hunts through local or remote servers in the background.</p>
            </article>

            <article class="feature feature-span-2">
              <p class="feature-index">D</p>
              <h3>Your agents announce themselves</h3>
              <p>Known command-line agents are recognized and labeled automatically, so a wall of busy terminals still makes sense at a glance.</p>
              <div class="agent-list" aria-label="Supported agent command line tools">
                <span>Codex</span><span>Claude</span><span>Cursor</span><span>Aider</span><span>Gemini</span><span>+ more</span>
              </div>
            </article>

            <article class="feature feature-span-3">
              <p class="feature-index">E</p>
              <h3>A browser in the group</h3>
              <p>Keep the docs, preview, or console beside the terminals doing the work — inside the same native layout.</p>
            </article>
          </div>
        </div>
      </section>

      <section class="section final">
        <div class="wrap">
          <p class="kicker"><b>†</b> Open source · Sharp edges welcome</p>
          <figure class="plate">
            <img src="/images/harness-harlot-wordmark.webp" alt="Harness Harlot" width="1000" height="500" loading="lazy" />
          </figure>
          <h2>One window. Every machine.</h2>
          <div class="cta-row">
            <a class="button button-primary" href={releaseUrl}>Get Harness Harlot</a>
            <a class="button button-secondary" href={repoUrl}>Explore on GitHub <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <div class="wrap footer-inner">
        <a class="brand" href="#top">
          <img class="brand-mark" src="/images/harness-harlot-mark.webp" alt="" width="32" height="32" loading="lazy" />
          <span class="brand-text">Harness Harlot</span>
        </a>
        <p>Native terminal workstation · macOS + Linux</p>
        <div class="footer-links">
          <a href={`${repoUrl}/releases`}>Releases</a>
          <a href={`${repoUrl}/blob/main/LICENSE`}>MIT License</a>
          <a href={xUrl} rel="me">X / @harnessharlot</a>
          <a href={repoUrl}>GitHub</a>
        </div>
      </div>
    </footer>

    <script>
      // theme -----------------------------------------------------
      const root = document.documentElement;
      const toggle = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
      const glyph = document.querySelector<HTMLElement>("[data-theme-glyph]");
      const themeLabel = document.querySelector<HTMLElement>("[data-theme-label]");

      function paintTheme(theme: "dark" | "light") {
        root.dataset.theme = theme;
        if (glyph) glyph.textContent = theme === "dark" ? "☾" : "☀";
        if (themeLabel) themeLabel.textContent = theme === "dark" ? "Nox" : "Lux";
        toggle?.setAttribute("aria-label", theme === "dark" ? "Switch to light theme" : "Switch to dark theme");
      }

      paintTheme(root.dataset.theme === "light" ? "light" : "dark");

      toggle?.addEventListener("click", () => {
        const next = root.dataset.theme === "light" ? "dark" : "light";
        localStorage.setItem("hh-theme", next);
        paintTheme(next);
      });

      // install panel --------------------------------------------
      function wireInstallPanel(panel: HTMLElement) {
        const commandEl = panel.querySelector<HTMLElement>("[data-command]");
        const copyButton = panel.querySelector<HTMLButtonElement>("[data-copy]");
        const copyStatus = panel.querySelector<HTMLElement>("[data-copy-status]");
        if (!commandEl) return;
        const command: HTMLElement = commandEl;

        copyButton?.addEventListener("click", async () => {
          const value = command.textContent ?? "";
          try {
            await navigator.clipboard.writeText(value);
            copyButton.textContent = "Copied";
            if (copyStatus) copyStatus.textContent = "Install command copied to your clipboard.";
          } catch {
            const selection = window.getSelection();
            if (selection) {
              const range = document.createRange();
              range.selectNodeContents(command);
              selection.removeAllRanges();
              selection.addRange(range);
            }
            if (copyStatus) copyStatus.textContent = "Command selected. Press Command+C or Control+C to copy.";
          }
        });
      }

      document.querySelectorAll<HTMLElement>(".install-panel").forEach(wireInstallPanel);
    </script>
  </body>
</html>
